# ==============================================================================
# Built-In Object Storage & Update Server - Environment Configuration
# ==============================================================================

# Server Listening Port (default: 3001)
PORT=3001

# ==============================================================================
# LOKASI FOLDER PENYIMPANAN OBJECT / BINARY (.dmg, .exe, .zip)
# ==============================================================================
# - Default development : ./binaries
# - Default Docker      : /app/binaries
STORAGE_DIR=./binaries

# File konfigurasi metadata rilis (release.json)
RELEASE_FILE=./release.json

# ==============================================================================
# KREDENSIAL LOGIN WEB ADMIN DASHBOARD
# ==============================================================================
# Username dan password untuk login ke Web Admin Portal (http://localhost:3001/)
# Kosongkan ADMIN_PASSWORD jika ingin mode tanpa proteksi login (dev mode).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password

# ==============================================================================
# SECURITY: API KEY UNTUK CI/CD PIPELINE
# ==============================================================================
# Token rahasia untuk upload dari script curl/pipeline CI/CD (Header: X-API-Key)
UPLOAD_AUTH_KEY=your_secure_random_api_key_here
